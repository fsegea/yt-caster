FROM python:3.12-slim AS builder

WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir --prefix /install -r requirements.txt


FROM python:3.12-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 appuser

WORKDIR /app

COPY --from=builder /install /usr/local
COPY app ./app
COPY static ./static
COPY VERSION ./VERSION

RUN mkdir -p /descargas && chown appuser:appuser /descargas

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/salud')"]

# yt-dlp queda fijado en requirements.txt (version auditable por commit/tag).
# Para forzar la ultima version sin reconstruir la imagen:
#   YT_DLP_ACTUALIZAR=1  (ej. en stack.portainer.yaml)
ENV YT_DLP_ACTUALIZAR=0

CMD ["sh", "-c", "if [ \"$YT_DLP_ACTUALIZAR\" = \"1\" ]; then pip install --user --ignore-installed -U yt-dlp || echo 'aviso: no se pudo actualizar yt-dlp'; fi; exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]